# Market Tracker en la nube (Railway), modo solo lectura. Ver la sección "Market Tracker en la nube" de CLAUDE.md.
# El bot de Telegram NO usa este fichero: sigue con el Procfile en su propio servicio.
FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production CLOUD_MODE=1
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .
EXPOSE 3000
HEALTHCHECK CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
